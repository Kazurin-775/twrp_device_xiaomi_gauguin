# SPDX-License-Identifier: Apache-2.0

on init
    write /sys/class/backlight/panel0-backlight/brightness 800
    # qseecomd drops itself to uid 1000 (system) before spawning its listener
    # threads; without this the listener opens of /dev/qseecom fail with EACCES
    # (the node defaults to 0600 root:root). Belt-and-braces with the ueventd
    # rule in vendor/etc/ueventd.rc.
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    # Keymaster + QSEE run from ramdisk blobs (recovery/root/vendor/) so that
    # keystore2 can retrieve the metadata encryption key without mounting /vendor.
    start vendor.qseecomd

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

on property:init.svc.vendor.qseecomd=running
    start keymaster-4-0

# USB (gadget setup, functionfs mounts, adbd start/UDC bind) lives in
# init.recovery.usb.rc. Here we only request the adb configuration once the
# configfs backend is up.
on boot
    setprop sys.usb.config adb

service vendor.qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64
    seclabel u:r:recovery:s0

service keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service-qti
    class core
    disabled
    user root
    group root system drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64
    seclabel u:r:recovery:s0
