# TWRP vendor.prop for Xiaomi Gauguin
# Crypto + board/platform + USB + storage

# Storage
external_storage.projid.enabled=1
external_storage.casefold.enabled=1
external_storage.sdcardfs.enabled=0

# Crypto — dm-default-key FBE on lito (matches stock vendor.prop)
ro.crypto.allow_encrypt_override=true
ro.crypto.dm_default_key.options_format.version=2
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.volume.metadata.method=dm-default-key
ro.crypto.volume.options=::v2

# Board / platform
ro.boot.dynamic_partitions=true
ro.product.board=gauguin
ro.board.platform=lito
ro.product.first_api_level=29
ro.vendor.build.security_patch=2023-06-01

# Gatekeeper (duplicated in vendor prop for FBE path)
vendor.gatekeeper.disable_spu=true
vendor.gatekeeper.is_security_level_spu=0

# USB
vendor.usb.use_ffs_mtp=1
vendor.usb.controller=a600000.dwc3
vendor.usb.rndis.func.name=gsi
vendor.usb.rmnet.func.name=gsi
vendor.usb.use_gadget_hal=1
